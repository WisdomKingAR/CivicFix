# ────────────────────────────────────────────────
# CivicFix — Root .gitignore
# ────────────────────────────────────────────────

# === DOCUMENTATION (internal — not for repo) ===
DOCUMENTATION/

# === Environment & Secrets ===
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# === Node / NPM ===
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# === Build Outputs ===
dist/
build/
.next/
out/

# === TypeScript ===
*.tsbuildinfo

# === Prisma ===
# Keep schema.prisma but ignore generated client
prisma/generated/

# === Logs ===
logs/
*.log

# === OS Artifacts ===
.DS_Store
Thumbs.db
desktop.ini

# === IDE ===
.vscode/
.idea/
*.swp
*.swo

# === Testing ===
coverage/
.nyc_output/

# === Misc ===
.cache/
tmp/
temp/
